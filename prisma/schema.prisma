// Prisma Schema for Money Tracker Web
// Database: SQLite (local file)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// MASTER DATA TABLES
// ============================================

// Categories for transactions (Income & Expense)
model Category {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   // "income" or "expense"
  icon        String?  // emoji or icon name
  color       String?  // hex color for UI
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  budgetItems  BudgetItem[]

  @@map("categories")
}

// ============================================
// REIMBURSEMENT OFFICE CATEGORIES
// ============================================

model ReimbursementCategory {
  id          Int      @id @default(autoincrement())
  name        String
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reimbursements Reimbursement[]

  @@map("reimbursement_categories")
}

// ============================================
// TRANSACTIONS (Main Book)
// ============================================

model Transaction {
  id          Int      @id @default(autoincrement())
  date        DateTime
  categoryId  Int
  description String
  income      Float    @default(0)
  expense     Float    @default(0)
  balance     Float?
  isSaving    Boolean  @default(false)
  savingsLocation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category      Category @relation(fields: [categoryId], references: [id])
  reimbursement Reimbursement? @relation("ReimbursementExpense")
  reimbursementPayment Reimbursement? @relation("ReimbursementPayment")

  @@index([date])
  @@index([categoryId])
  @@map("transactions")
}

// ============================================
// REIMBURSEMENT MODULE (Simple)
// ============================================

model Reimbursement {
  id              Int      @id @default(autoincrement())
  transactionId   Int      @unique
  officeCategoryId Int
  receiptPhoto    String?  // File path to uploaded receipt
  notes           String?
  status          String   @default("pending") // "pending", "paid"
  paidDate        DateTime? // Date when marked as paid
  paymentTransactionId Int? @unique // Income transaction recorded when the office pays this claim
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transaction     Transaction @relation("ReimbursementExpense", fields: [transactionId], references: [id], onDelete: Cascade)
  paymentTransaction Transaction? @relation("ReimbursementPayment", fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  officeCategory  ReimbursementCategory @relation(fields: [officeCategoryId], references: [id])

  @@index([status])
  @@index([transactionId])
  @@map("reimbursements")
}

// ============================================
// SETTINGS & PREFERENCES
// ============================================

model AppSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

// ============================================
// COMPANY PROFILES (For Export)
// ============================================

model CompanyProfile {
  id          Int      @id @default(autoincrement())
  name        String
  logoPath    String?  // Path to uploaded logo file
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_profiles")
}

// ============================================
// BUDGET PLANNING MODULE
// ============================================

model BudgetPeriod {
  id           Int          @id @default(autoincrement())
  month        Int          // 1 - 12
  year         Int          // e.g. 2026
  targetIncome Float        @default(0) // Total target pendapatan bulanan
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items        BudgetItem[]

  @@unique([month, year])
  @@index([year, month])
  @@map("budget_periods")
}

model BudgetItem {
  id             Int          @id @default(autoincrement())
  budgetPeriodId Int
  categoryId     Int
  targetAmount   Float        @default(0) // Target alokasi pengeluaran per kategori
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  budgetPeriod   BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetPeriodId, categoryId])
  @@index([budgetPeriodId])
  @@index([categoryId])
  @@map("budget_items")
}

